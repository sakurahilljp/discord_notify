# discord_notify .env Template
# Copy this file to '.env' in your working directory

# Option A: Discord Webhook URL (Easiest)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# Option B: Discord Bot Token & Target Text Channel ID
# DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
# DISCORD_CHANNEL_ID="YOUR_TEXT_CHANNEL_ID"

# Optional customizations (Webhook only)
DISCORD_USERNAME="Notification Bot"
# DISCORD_AVATAR_URL="https://example.com/avatar.png"
